{
  "name": "@aiw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API TypeScript: organizaciones, departamentos, puestos, versiones, políticas, contador, auditoría y servidor MCP hacia fuera.",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@aiw/db": "workspace:*",
    "@aiw/domain": "workspace:*",
    "@aiw/ledger": "workspace:*",
    "@aiw/mcp-gateway": "workspace:*",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
