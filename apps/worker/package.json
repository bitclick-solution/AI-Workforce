{
  "name": "@aiw/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Temporal: flujos de tarea, delegación entre agentes, bucle del agente y aprendizaje programado.",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "demo:cobros": "tsx src/demo-cobros.ts",
    "decidir": "tsx src/demo-decidir.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist coverage .turbo",
    "demo:sala": "tsx src/demo-sala.ts",
    "demo:aprendizaje": "tsx src/demo-aprendizaje.ts",
    "aprendizaje": "tsx src/demo-aprendizaje-cli.ts",
    "comprobar:centrifugo": "tsx src/comprobar-centrifugo.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "catalog:",
    "@aiw/connector-demo": "workspace:*",
    "@aiw/db": "workspace:*",
    "@aiw/domain": "workspace:*",
    "@aiw/evals": "workspace:*",
    "@aiw/learning": "workspace:*",
    "@aiw/ledger": "workspace:*",
    "@aiw/mcp-gateway": "workspace:*",
    "@aiw/models": "workspace:*",
    "@aiw/platform-agents": "workspace:*",
    "@aiw/rooms": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@temporalio/testing": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
