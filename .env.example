# Entorno de desarrollo de AI Workforce.
# `pnpm dev:up` copia este fichero a .env y sustituye cada GENERAR por un valor aleatorio local.
# Este fichero no contiene ningún valor real y es el único .env que se versiona.

NODE_ENV=development

# PostgreSQL 16 con pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERAR
POSTGRES_PORT=5432

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# Centrifugo
CENTRIFUGO_PORT=8000
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=GENERAR
CENTRIFUGO_API_KEY=GENERAR
CENTRIFUGO_ADMIN_PASSWORD=GENERAR
CENTRIFUGO_ADMIN_SECRET=GENERAR
# Sala v1: la API y el trabajador llaman al API HTTP de Centrifugo con estas dos
# (server a server, nunca al navegador); el navegador solo recibe el WebSocket
# público, sin secreto ninguno.
AIW_CENTRIFUGO_URL=http://127.0.0.1:8000
AIW_CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket

# Silo (almacén de objetos S3 en local, ADR-012). Un .env anterior con nombres MINIO_* sigue funcionando.
S3_ROOT_USER=aiw
S3_ROOT_PASSWORD=GENERAR
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Langfuse y sus dependencias
LANGFUSE_PORT=3001
LANGFUSE_SALT=GENERAR
LANGFUSE_ENCRYPTION_KEY=GENERAR
LANGFUSE_NEXTAUTH_SECRET=GENERAR
LANGFUSE_INIT_USER_EMAIL=dev@aiworkforce.local
LANGFUSE_INIT_USER_PASSWORD=GENERAR
LANGFUSE_PUBLIC_KEY=pk-lf-GENERAR
LANGFUSE_SECRET_KEY=sk-lf-GENERAR
CLICKHOUSE_PASSWORD=GENERAR
REDIS_PASSWORD=GENERAR

# API y panel. Cadena de conexión de la aplicación: vacía a propósito, se compone con los
# valores de PostgreSQL de arriba y nunca se versiona con contraseña dentro.
DATABASE_URL=
AIW_API_PUERTO=3002
# Puerto del panel (Next.js). `pnpm local:arrancar` lo pasa como PORT al arrancarlo;
# solo hace falta cambiarlo si el 3000 ya está ocupado por otra cosa en tu máquina
# o, en un ejecutor compartido, por un servicio de producción.
AIW_WEB_PUERTO=3000

# Contador de tareas v0 (rebanada «Contador de tareas v0»). Con la bandera a 0 la API no
# expone las rutas del contador; el token es obligatorio para que se activen, así que sin
# él la ruta no existe ni con la bandera puesta.
AIW_CONTADOR_V0=0
AIW_CONTADOR_TOKEN=GENERAR

# Panel del contador en el web, detrás de su propia bandera. El token no llega al navegador:
# lo pone el servidor de Next al llamar a la API.
AIW_PANEL_CONTADOR=0
AIW_API_URL=http://127.0.0.1:3002

# Acceso al panel (rebanada «Acceso al panel»): Better Auth con enlace por correo y passkey.
# Con la bandera a 0 no hay /api/auth ni sesiones, y sala y contador responden 401: el
# tenant ya no llega por cabecera ni por entorno, solo de la sesión. El secreto firma las
# cookies: 32 caracteres o más (`openssl rand -base64 48`). La URL pública es la del panel
# tal como la ve el navegador; WebAuthn solo admite http en localhost.
# Alta solo por invitación: `pnpm --filter @aiw/api invitar-propietario --organizacion … --nombre … --correo …`.
AIW_ACCESO_PANEL=0
AIW_ACCESO_SECRETO=GENERAR
AIW_WEB_URL_PUBLICA=http://localhost:3000
AIW_SESION_HORAS=12
AIW_ACCESO_ENLACE_MINUTOS=15

# Sala v0 en el panel (rebanada «Sala v0»). Con la bandera a 0 la API no expone las
# rutas de la sala. `pnpm local:arrancar` la enciende junto al resto de banderas de
# la demostración, con un token aleatorio local; fuera de eso se pone a mano. El
# tenant y la persona salen de la sesión («Acceso al panel»), nunca del entorno.
AIW_SALA_V0=0
AIW_SALA_TOKEN=GENERAR

# Sala v1 (rebanada «Sala v1 · salas por equipo y presencia en vivo»): salas por
# equipo y presencia por Centrifugo, detrás de su propia bandera, hasta la
# demostración. Necesita AIW_SALA_V0 y las variables de Centrifugo de arriba.
AIW_SALA_V1=0

# Inicio del panel (rebanada «Inicio del panel: widgets y avisos»). Con la bandera
# a 0, /panel/inicio da 404 y la API no expone /api/inicio/**. `pnpm local:arrancar`
# la enciende junto al resto de banderas de la demostración, igual que AIW_SALA_V1.
AIW_INICIO_PANEL=0

# Mailpit: servidor de correo de desarrollo. Captura todo y no entrega nada fuera.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Aprobación por correo con enlaces firmados de un solo uso.
# La bandera de funcionalidad viene apagada: sin ella, el proceso de canales no abre
# puerto ni envía correo, y el contenedor arranca y termina como antes.
AIW_APROBACION_CORREO=0
AIW_APROBACION_CLAVE_FIRMA=GENERAR
AIW_APROBACION_URL_PUBLICA=http://localhost:4010
AIW_APROBACION_PUERTO=4010
AIW_APROBACION_VALIDEZ_HORAS=72

# Correo: `memoria` guarda el mensaje en el proceso, `smtp` lo manda de verdad.
AIW_CORREO_PROVEEDOR=memoria
AIW_CORREO_REMITENTE=agentes@aiworkforce.local
AIW_CORREO_SMTP_HOST=localhost
AIW_CORREO_SMTP_PUERTO=1025
AIW_CORREO_SMTP_TLS=0
# Mailpit no autentica. En producción, usuario y contraseña llegan del gestor de
# secretos y no de este fichero: por eso van vacíos.
AIW_CORREO_SMTP_USUARIO=
AIW_CORREO_SMTP_CONTRASENA=

# Señal al flujo: `memoria` la captura, `temporal` la manda al flujo de la tarea.
AIW_SENAL_PROVEEDOR=memoria
AIW_SENAL_NOMBRE=decisionDeAprobacion
AIW_TEMPORAL_DIRECCION=localhost:7233
AIW_TEMPORAL_ESPACIO=default

# Conector de Odoo (rebanada «Conector Odoo v0»). Detrás de su bandera: con 0 el
# proceso no abre transporte ni toca el ERP. Las credenciales las inyecta el gateway
# MCP al lanzar el conector y aquí van vacías o con GENERAR; el MCP dinámico corre
# como imagen aislada, una por tenant, con estos mismos valores en su propio entorno.
AIW_CONECTOR_ODOO=0
ODOO_URL=
ODOO_BASE=
ODOO_USUARIO=
ODOO_CLAVE_API=GENERAR
ODOO_MCP_URL=http://odoo-mcp:8000/mcp

# Conector de Factusol (rebanada «Conector Factusol v0»). Detrás de su bandera: con 0 el
# proceso no abre transporte ni toca Factusol. Las credenciales las inyecta el gateway MCP
# al lanzar el conector y aquí van vacías o con GENERAR. El token es el del agente, nunca el
# que lleva el scope «confirmar»: con él el conector no arranca. El de confirmación
# (ADR-031) lo guarda el gateway y solo lo entrega a una escritura ya aprobada.
AIW_CONECTOR_FACTUSOL=0
FACTUSOL_MCP_URL=
FACTUSOL_MCP_TOKEN=GENERAR
FACTUSOL_TENANT_ID=
FACTUSOL_MCP_TOKEN_CONFIRMAR=
FACTUSOL_CONFIRMACION=B
FACTUSOL_ESTADO_DIR=

# Proveedores de modelos: vacíos a propósito. Las claves reales viven en el gestor de secretos,
# nunca en el repositorio, en prompts ni en registros.
# ANTHROPIC_API_KEY es solo para usos internos sin datos de clientes (ADR-017): Revisor en
# la integración continua, fábrica de agentes, evals con datos sintéticos.
ANTHROPIC_API_KEY=

# Proveedor de modelos de los procesos que hacen decidir a un agente (ADR-023): el trabajador,
# `pnpm local:arrancar` y `pnpm --filter @aiw/worker bitclick:cobros`. Cambiar de proveedor es
# cambiar el valor de estas variables, nunca código — ver docs/runbooks/vertex-wif.md.
#
#   prueba      Proveedor determinista, sin claves y sin coste: es el de la demo local, de la CI y
#               de los evals de humo. Solo se usa si se escribe aquí: un proceso sin esta variable
#               NO cae a prueba, arranca con Bedrock y, si le faltan credenciales, se niega a arrancar.
#   bedrock-ue  Bedrock UE clásico (perfiles de inferencia UE, ADR-023). Es el valor por defecto de
#               un proceso sin variable. Necesita AIW_BEDROCK_REGION_UE y las credenciales de AWS
#               de más abajo. Cada paso cuesta dinero de verdad: docs/runbooks/proveedor-real-local.md.
#   vertex-ue   Vertex UE, implementado e inactivo hasta que Google conceda cuota.
#
# El valor por defecto de este ejemplo es `prueba`, para que la demo local del viernes y las
# pruebas no cambien. Para usar el modelo real en local, cámbialo a `bedrock-ue` en tu .env y
# rellena las tres variables de AWS.
AIW_PROVEEDOR_MODELOS=prueba
# Proveedor al que pasa un paso si el principal falla (por defecto vertex-ue). Se ignora con `prueba`.
AIW_PROVEEDOR_MODELOS_RESPALDO=

# Ruta de Anthropic sobre Vertex UE (ADR-017, ADR-023 — implementado, inactivo sin cuota).
# AIW_VERTEX_REGION_UE=eu activa la multirregión europea (recomendada, residencia UE,
# comprobado en docs.claude.com el 2026-09-29); también admite una región concreta "europe-*".
# El arranque rechaza cualquier otra ubicación. Sin estas dos variables, @aiw/models no
# construye el cliente real. Sin clave de API: el SDK de Vertex se autentica siempre por
# credenciales de Google (por defecto de la aplicación en local, cuenta de servicio en
# producción y en CI) — nunca por una entrada de este fichero; ver el runbook.
AIW_VERTEX_REGION_UE=
AIW_VERTEX_PROJECT_ID=

# Ruta de Anthropic sobre Bedrock UE (ADR-017; proveedor principal por defecto desde ADR-023,
# revisado el 2026-09-29). Región elegida: eu-north-1 (Estocolmo), no eu-central-1 (Frankfurt): el endpoint de
# Mensajes de Bedrock no ofrece ningún modelo de Anthropic en Frankfurt, y eu-north-1 es
# donde el camino clásico (el que usa hoy @aiw/models) expone los perfiles de inferencia UE a
# los que la cuenta tiene acceso. Sin estas variables, @aiw/models no construye el cliente
# real; ver el runbook de funciones ausentes en docs/runbooks/modelos-funciones-ausentes.md.
AIW_BEDROCK_REGION_UE=
# Credenciales de AWS por la cadena estándar del SDK (decisión de Jesús, 2026-09-25): en
# local, las del usuario IAM aiw-dev; en producción, las del usuario IAM aiw-prod. Nunca las
# mismas en los dos sitios. En GitHub Actions no se guardan claves: el rol aiw-ci-bedrock se
# asume por OIDC (docs/runbooks/bedrock-iam-oidc.md), así que AWS_ROLE_ARN es una variable del
# repositorio, no una entrada de este fichero.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Anulación opcional del identificador que resuelve identificadores.ts para bedrock-eu (hoy,
# perfiles de inferencia UE del camino clásico, ver el runbook). Vacía mientras la tabla
# resuelva el identificador correcto en el catálogo de modelos de la consola de Bedrock.
AIW_BEDROCK_IDENTIFICADOR_MODELO=

# Coste por tarea completada a Langfuse (ADR-018). En desarrollo, la instancia de Langfuse
# del Compose de arriba (mismo puerto que LANGFUSE_PORT); sin las dos claves, @aiw/models
# usa un observador nulo.
LANGFUSE_BASE_URL=http://localhost:3001

# Prueba técnica del stack: Temporal, bucle del agente sobre AI SDK y gateway MCP.
# Con la bandera apagada el proceso del trabajador imprime qué le falta y termina con
# código cero: así el job «Imagen worker» de la CI lo arranca sin entorno y la rebanada
# se puede desplegar en staging antes de la demostración.
AIW_PRUEBA_STACK=0
AIW_TEMPORAL_COLA=aiw-prueba-stack

# Conector de demostración. `pnpm dev:up` sustituye GENERAR por un valor aleatorio local.
# El gateway resuelve la credencial por `conector.referencia_secreto` y la mete en el
# transporte —variable de entorno del proceso hijo, o cabecera de autorización por HTTP—;
# no aparece en ningún mensaje al modelo ni en ninguna traza, y dos pruebas lo comprueban
# rastreando su valor. El contrato de las dos herramientas está en connectors/demo/README.md.
DEMO_CONECTOR_SECRETO=GENERAR
# Puerto del conector servido por HTTP transmisible (`servir --http`).
DEMO_CONECTOR_PUERTO=4020
# Cuántas llamadas falla a propósito con motivo `temporal`, para probar los reintentos.
DEMO_CONECTOR_FALLOS=0

# Tenant con el que corre el mandato `decidir` de la demostración. La demostración lo
# imprime al sembrar; vacío a propósito porque cambia en cada ejecución.
AIW_TENANT=

# Trazas del paso de modelo. Langfuse recoge por el protocolo abierto de telemetría, así
# que el exportador es configuración del proceso y no código: apunta estas variables al
# Langfuse del Compose. Sin ellas, las trazas se quedan en memoria y la CI sigue siendo
# determinista.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=aiw-worker
