{
  "name": "@aiw/connector-factusol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Conector MCP de Factusol: facturas vencidas y nota de seguimiento sobre Factusol MCP, consumido como imagen aislada.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "iniciar": "tsx src/servidor.ts",
    "start": "node dist/servidor.js",
    "demo:factusol": "tsx src/demo-factusol.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
